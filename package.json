{
  "name": "vault-sync",
  "version": "0.1.0",
  "description": "GitHub-backed synchronization for Obsidian vaults and LLM-accessible Markdown knowledge bases.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "keywords": ["obsidian", "github", "sync", "markdown"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
